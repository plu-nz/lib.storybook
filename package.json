{
  "name": "@plunz/storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "deploy": "pnpm run build:storybook && wrangler deploy"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0",
    "solid-js": "^2.0.0"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.3",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "solid-js": "^2.0.3",
    "storybook": "10.6.7",
    "storybook-solidjs-vite": "10.7.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "4.149.0"
  }
}
